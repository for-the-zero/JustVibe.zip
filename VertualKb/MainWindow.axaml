<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VertualKb.MainWindow"
        Title="VertualKb 虚拟键盘"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyBackgroundFallback="#E01F1F23"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        Width="650" Height="1080"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">

  <Panel>
    <!-- 折叠后的把手：竖排文字，点击展开 -->
    <LayoutTransformControl HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                            IsVisible="False" x:Name="HandleHost">
      <LayoutTransformControl.LayoutTransform>
        <RotateTransform Angle="-90"/>
      </LayoutTransformControl.LayoutTransform>
      <Button x:Name="ExpandHandle" Classes="kb special" Width="300" Height="68" FontSize="22">
        ⌨ 打开键盘
      </Button>
    </LayoutTransformControl>

    <!-- 键盘主体：按竖屏手机键盘布局排版，整体旋转 -90°（空格贴屏幕右缘） -->
    <Border x:Name="KeyboardRoot" Background="#A01F1F23" CornerRadius="8">
      <LayoutTransformControl x:Name="PortraitHost">
        <LayoutTransformControl.LayoutTransform>
          <TransformGroup>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
            <RotateTransform Angle="-90"/>
          </TransformGroup>
        </LayoutTransformControl.LayoutTransform>

        <Grid x:Name="PortraitGrid" Width="1024" Height="650">
          <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- 顶栏（旋转后位于手机端顶部）：双击折叠 / 输入预览 / 清除 / 关闭 -->
          <Grid x:Name="TopBar" Grid.Row="0" Margin="6,6,6,2" ColumnDefinitions="*,96,76">
            <Border Grid.Column="0" Background="#40000000" BorderBrush="#30FFFFFF" BorderThickness="1"
                    CornerRadius="6" Margin="0,0,4,0">
              <TextBlock x:Name="PreviewText" VerticalAlignment="Center" Margin="14,0"
                         FontSize="26" Foreground="#9FD1FF" Text="▍"/>
            </Border>
            <Button x:Name="ClearButton" Classes="bar" Grid.Column="1" FontSize="20">清除</Button>
            <Button x:Name="ExitButton" Classes="bar" Grid.Column="2" FontSize="22">✕</Button>
          </Grid>

          <ContentControl x:Name="KeysHost" Grid.Row="1" Margin="8,2,8,8"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
      </LayoutTransformControl>
    </Border>
  </Panel>
</Window>
