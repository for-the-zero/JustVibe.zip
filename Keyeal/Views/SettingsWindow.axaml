<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Keyeal.Models"
        xmlns:v="clr-namespace:Keyeal.Views"
        x:Class="Keyeal.Views.SettingsWindow"
        Title="Keyeal · 设置"
        Width="680" Height="740"
        MinWidth="540" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        CanResize="True">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- 顶部状态与快速开关 -->
    <Border Background="{DynamicResource SystemChromeMediumColor}" Padding="20,14" BorderBrush="{DynamicResource SystemControlTransientBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Keyeal 键盘与鼠标可视化" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="极简录屏演示增强 · 托盘常驻" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="键盘" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
            <ToggleSwitch IsChecked="{Binding ShowKeyTrack}" Margin="0" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="鼠标" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
            <ToggleSwitch IsChecked="{Binding MouseEnabled}" Margin="0" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="总开关" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
            <ToggleSwitch IsChecked="{Binding Enabled}" Margin="0" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 单页滚动设置主体 -->
    <ScrollViewer Grid.Row="1" Padding="24,16,24,16">
      <StackPanel Spacing="22" MaxWidth="620" HorizontalAlignment="Stretch">

        <!-- ================= 1. 常规运行 ================= -->
        <StackPanel Spacing="10">
          <TextBlock Text="常规运行" FontSize="15" FontWeight="SemiBold" />
          <Separator Margin="0,0,0,4" />

          <Grid ColumnDefinitions="*,Auto" Margin="0,2">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="开机自启（最高权限）" FontSize="13" />
              <TextBlock Text="通过 Windows 任务计划程序静默提权启动，不弹 UAC 对话框。" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoStart}" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto" Margin="0,2">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="忽略软件模拟输入" FontSize="13" />
              <TextBlock Text="防无限循环触发，仅可视化真实物理输入。" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IgnoreInjected}" />
          </Grid>

          <Grid ColumnDefinitions="160,*" Margin="0,4">
            <TextBlock Text="轨道显示屏" VerticalAlignment="Center" FontSize="13" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="200"
                      ItemsSource="{x:Static v:EnumLists.TrackScreenValues}"
                      SelectedItem="{Binding TrackScreen}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={x:Static v:EnumNameConverter.Instance}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </StackPanel>

        <!-- ================= 2. 键盘可视化 ================= -->
        <StackPanel Spacing="10">
          <TextBlock Text="键盘可视化" FontSize="15" FontWeight="SemiBold" />
          <Separator Margin="0,0,0,4" />

          <Grid ColumnDefinitions="160,*" Margin="0,2">
            <TextBlock Text="停靠位置" VerticalAlignment="Center" FontSize="13" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="200"
                      ItemsSource="{x:Static v:EnumLists.PositionValues}"
                      SelectedItem="{Binding Position}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={x:Static v:EnumNameConverter.Instance}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <Grid ColumnDefinitions="160,*,70" Margin="0,2">
            <TextBlock Text="气泡高度" VerticalAlignment="Center" FontSize="13" />
            <Slider Grid.Column="1" Minimum="36" Maximum="100" Value="{Binding BubbleHeight}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="{Binding BubbleHeight, StringFormat={}{0:0} px}" />
          </Grid>

          <Grid ColumnDefinitions="160,*,70" Margin="0,2">
            <TextBlock Text="静默消失延时" VerticalAlignment="Center" FontSize="13" />
            <Slider Grid.Column="1" Minimum="0" Maximum="5000" Value="{Binding DwellTime}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="{Binding DwellTime, StringFormat={}{0:0} ms}" />
          </Grid>

          <Grid ColumnDefinitions="160,*,70" Margin="0,2">
            <TextBlock Text="按压触发大小" VerticalAlignment="Center" FontSize="13" />
            <Slider Grid.Column="1" Minimum="0.8" Maximum="1.5" Value="{Binding PressedScale}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="{Binding PressedScale, StringFormat={}{0:0.00}x}" />
          </Grid>

          <Grid ColumnDefinitions="160,*" Margin="0,2">
            <TextBlock Text="弹出动画" VerticalAlignment="Center" FontSize="13" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="200"
                      ItemsSource="{x:Static v:EnumLists.EnterAnimationValues}"
                      SelectedItem="{Binding Enter}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={x:Static v:EnumNameConverter.Instance}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <Grid ColumnDefinitions="160,*" Margin="0,2">
            <TextBlock Text="退场动画" VerticalAlignment="Center" FontSize="13" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="200"
                      ItemsSource="{x:Static v:EnumLists.ExitAnimationValues}"
                      SelectedItem="{Binding Exit}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={x:Static v:EnumNameConverter.Instance}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <StackPanel Spacing="6" Margin="0,4,0,0">
            <TextBlock Text="清空轨道的控制键" FontSize="13" />
            <StackPanel Orientation="Horizontal" Spacing="16">
              <CheckBox x:Name="ChkCtrl" Content="Ctrl" Click="OnClearModChanged" />
              <CheckBox x:Name="ChkShift" Content="Shift" Click="OnClearModChanged" />
              <CheckBox x:Name="ChkAlt" Content="Alt" Click="OnClearModChanged" />
              <CheckBox x:Name="ChkWin" Content="Win" Click="OnClearModChanged" />
            </StackPanel>
          </StackPanel>

          <!-- 配色方案 -->
          <StackPanel Spacing="6" Margin="0,4,0,0">
            <TextBlock Text="预设配色方案" FontSize="13" />
            <ItemsControl ItemsSource="{x:Static m:Settings.Palettes}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Margin="0,0,6,6" Padding="10,5" Click="OnPaletteClick" BorderThickness="1">
                    <TextBlock Text="{Binding Name}" FontSize="12" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- 颜色自定义 -->
          <Grid ColumnDefinitions="*,12,*,12,*" Margin="0,4">
            <StackPanel Spacing="4">
              <TextBlock Text="键帽背景" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
              <v:ColorField Color="{Binding BgColor}" />
            </StackPanel>
            <StackPanel Spacing="4" Grid.Column="2">
              <TextBlock Text="按压触发" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
              <v:ColorField Color="{Binding PressedColor}" />
            </StackPanel>
            <StackPanel Spacing="4" Grid.Column="4">
              <TextBlock Text="文字颜色" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
              <v:ColorField Color="{Binding TextColor}" />
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- ================= 3. 鼠标录屏特效 ================= -->
        <StackPanel Spacing="10">
          <TextBlock Text="鼠标特效（录屏演示增强）" FontSize="15" FontWeight="SemiBold" />
          <Separator Margin="0,0,0,4" />

          <Grid ColumnDefinitions="160,*" Margin="0,2">
            <TextBlock Text="拖尾类型" VerticalAlignment="Center" FontSize="13" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="220"
                      ItemsSource="{x:Static v:EnumLists.TrailValues}"
                      SelectedItem="{Binding Trail}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={x:Static v:EnumNameConverter.Instance}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <Grid ColumnDefinitions="160,*" Margin="0,2">
            <TextBlock Text="拖尾画笔颜色" VerticalAlignment="Center" FontSize="13" />
            <v:ColorField Grid.Column="1" Color="{Binding TrailColor}" HorizontalAlignment="Left" />
          </Grid>

          <Grid ColumnDefinitions="160,*,70" Margin="0,2">
            <TextBlock Text="画笔粗细" VerticalAlignment="Center" FontSize="13" />
            <Slider Grid.Column="1" Minimum="1.5" Maximum="30" Value="{Binding TrailSize}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="{Binding TrailSize, StringFormat={}{0:0.0} px}" />
          </Grid>

          <Grid ColumnDefinitions="160,*,70" Margin="0,2">
            <TextBlock Text="拖尾消失时长" VerticalAlignment="Center" FontSize="13" />
            <Slider Grid.Column="1" Minimum="100" Maximum="1500" Value="{Binding TrailLifetime}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="{Binding TrailLifetime, StringFormat={}{0:0} ms}" />
          </Grid>

          <!-- 点击效果 -->
          <Grid ColumnDefinitions="160,*" Margin="0,6,0,2">
            <TextBlock Text="点击特效" VerticalAlignment="Center" FontSize="13" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="200"
                      ItemsSource="{x:Static v:EnumLists.ClickFxValues}"
                      SelectedItem="{Binding ClickEffect}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={x:Static v:EnumNameConverter.Instance}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <Grid ColumnDefinitions="160,*,70" Margin="0,2">
            <TextBlock Text="波纹尺寸" VerticalAlignment="Center" FontSize="13" />
            <Slider Grid.Column="1" Minimum="15" Maximum="100" Value="{Binding ClickSize}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="{Binding ClickSize, StringFormat={}{0:0} px}" />
          </Grid>

          <Grid ColumnDefinitions="160,*,70" Margin="0,2">
            <TextBlock Text="波纹线宽" VerticalAlignment="Center" FontSize="13" />
            <Slider Grid.Column="1" Minimum="0.5" Maximum="6" Value="{Binding RingThickness}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="{Binding RingThickness, StringFormat={}{0:0.0} px}" />
          </Grid>

          <!-- 左右键独立分色 -->
          <Grid ColumnDefinitions="*,12,*,12,*" Margin="0,4">
            <StackPanel Spacing="4">
              <TextBlock Text="左键颜色" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
              <v:ColorField Color="{Binding LeftColor}" />
            </StackPanel>
            <StackPanel Spacing="4" Grid.Column="2">
              <TextBlock Text="右键颜色" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
              <v:ColorField Color="{Binding RightColor}" />
            </StackPanel>
            <StackPanel Spacing="4" Grid.Column="4">
              <TextBlock Text="中键颜色" FontSize="12" Foreground="{DynamicResource SystemBaseMediumColor}" />
              <v:ColorField Color="{Binding MiddleColor}" />
            </StackPanel>
          </Grid>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- 底部操作栏 -->
    <Border Grid.Row="2" Background="{DynamicResource SystemChromeMediumColor}" Padding="20,12" BorderBrush="{DynamicResource SystemControlTransientBorderBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Content="恢复默认" Click="OnReset" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
          <Button Content="完成" Theme="{StaticResource AccentButtonStyle}" Click="OnDone" MinWidth="80" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
