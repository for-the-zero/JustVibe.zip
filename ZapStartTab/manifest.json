{
    "manifest_version": 3,
    "name": "ZapStartTab",
    "version": "1.2",
    "description": "Keyboard-driven new tab page",
    "chrome_url_overrides": {
        "newtab": "newtab.html"
    },
    "permissions": [
        "storage",
        "unlimitedStorage",
        "favicon"
    ],
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    }
}